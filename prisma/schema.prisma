// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  FACULTY
  ADMIN
}

enum ResourceType {
  PDF_NOTES
  LECTURE_VIDEO
  PPT_SLIDES
  ASSIGNMENT
  LAB_MANUAL
  REFERENCE_BOOK
  CODE_REPOSITORY
}

enum ExamType {
  MID_SEM
  END_SEM
  QUIZ
  SUPPLEMENTARY
}

enum ArticleDifficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id              String         @id @default(cuid())
  name            String
  email           String         @unique
  passwordHash    String?
  emailVerifiedAt DateTime?
  image           String?
  role            String         @default("STUDENT") // STUDENT, FACULTY, ADMIN
  currentYear     Int            @default(1)
  currentSemester Int            @default(1)
  specialization  String?        // BD, SE, IOT, ML
  bio             String?
  streakDays      Int            @default(1)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  accounts        Account[]
  sessions        Session[]
  bookmarks       Bookmark[]
  progress        Progress[]
  auditLogs       AuditLog[]

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model AcademicYear {
  id          Int        @id @default(autoincrement())
  yearNumber  Int        @unique // 1, 2, 3, 4
  title       String     // "1st Year - Foundation & Core Engineering"
  description String
  semesters   Semester[]

  @@map("academic_years")
}

model Semester {
  id             Int          @id @default(autoincrement())
  semesterNumber Int          @unique // 1 to 8
  title          String       // "Semester I", "Semester II", etc.
  totalCredits   Float        @default(20.0)
  academicYearId Int
  academicYear   AcademicYear @relation(fields: [academicYearId], references: [id], onDelete: Cascade)
  subjects       Subject[]

  @@map("semesters")
}

model Subject {
  id                   String       @id @default(cuid())
  code                 String       @unique // e.g. "UCS3011", "UMA1003"
  title                String       // "Data Structures and Algorithms"
  slug                 String       @unique // "data-structures-and-algorithms"
  credits              Float        @default(4.0)
  lectureHours         Int          @default(3) // L
  tutorialHours        Int          @default(1) // T
  practicalHours       Int          @default(0) // P
  internalMarks        Int          @default(40) // CIE
  externalMarks        Int          @default(60) // ESE
  totalMarks           Int          @default(100)
  isElective           Boolean      @default(false)
  isLab                Boolean      @default(false)
  electiveCategory     String?      // "Elective-I", "Open Elective-II", etc.
  specializationStream String?      // "BD" (Big Data), "SE" (Software Eng), "IOT", "ML"
  department           String       @default("CSE") // "CSE", "MGMT", "ME", "EE", "EC", "IBST"
  description          String
  iconName             String?      @default("BookOpen")
  order                Int          @default(0)

  semesterId           Int
  semester             Semester     @relation(fields: [semesterId], references: [id], onDelete: Cascade)
  
  units                Unit[]
  resources            Resource[]
  pyqs                 PYQ[]
  articles             Article[]
  bookmarks            Bookmark[]

  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt

  @@map("subjects")
}

model Unit {
  id          String    @id @default(cuid())
  unitNumber  Int       // 1, 2, 3, 4, 5
  title       String    // "Unit 1: Arrays and Linked Lists"
  description String?
  topics      String    // JSON or comma/newline separated topic list
  
  subjectId   String
  subject     Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  articles    Article[]
  resources   Resource[]

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([subjectId, unitNumber])
  @@map("units")
}

model Article {
  id               String            @id @default(cuid())
  title            String            // "Singly Linked List Insertion & Deletion"
  slug             String            @unique
  summary          String
  difficulty       String            @default("BEGINNER") // BEGINNER, INTERMEDIATE, ADVANCED
  readTimeMinutes  Int               @default(7)
  order            Int               @default(1)
  
  conceptContent   String            // Detailed explanation with markdown/sections
  codeExamples     String?           // JSON array of code snippets with lang, title, code, explanation
  diagramAscii     String?           // ASCII / Mermaid diagram or diagram description
  keyPoints        String?           // JSON array of bullet points
  commonMistakes   String?           // JSON array of pitfalls/mistakes to avoid
  practiceQuiz     String?           // JSON array of question, options, answerIndex, explanation
  tags             String?           // comma separated tags
  
  isPublished      Boolean           @default(true)
  viewCount        Int               @default(0)

  subjectId        String
  subject          Subject           @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  unitId           String?
  unit             Unit?             @relation(fields: [unitId], references: [id], onDelete: SetNull)
  
  bookmarks        Bookmark[]
  progress         Progress[]

  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@map("articles")
}

model Resource {
  id           String       @id @default(cuid())
  title        String
  description  String?
  type         String       // PDF_NOTES, LECTURE_VIDEO, PPT_SLIDES, ASSIGNMENT, LAB_MANUAL, REFERENCE_BOOK
  url          String
  fileSize     String?      // e.g. "4.2 MB"
  downloadCount Int         @default(0)
  isVerified   Boolean      @default(true)
  tags         String?

  subjectId    String
  subject      Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  unitId       String?
  unit         Unit?        @relation(fields: [unitId], references: [id], onDelete: SetNull)

  bookmarks    Bookmark[]

  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("resources")
}

model PYQ {
  id             String    @id @default(cuid())
  examYear       Int       // e.g. 2024, 2023, 2022
  examType       String    @default("END_SEM") // MID_SEM, END_SEM, QUIZ
  questionPdfUrl String
  solutionPdfUrl String?
  totalMarks     Int       @default(60)
  durationMinutes Int      @default(180)
  isImportant    Boolean   @default(false)
  downloadCount  Int       @default(0)
  keyTopicsCovered String?

  subjectId      String
  subject        Subject   @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  bookmarks      Bookmark[]

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@map("pyqs")
}

model Bookmark {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemType   String    // "SUBJECT", "ARTICLE", "RESOURCE", "PYQ"
  
  subjectId  String?
  subject    Subject?  @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  articleId  String?
  article    Article?  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  resourceId String?
  resource   Resource? @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  pyqId      String?
  pyq        PYQ?      @relation(fields: [pyqId], references: [id], onDelete: Cascade)

  createdAt  DateTime  @default(now())

  @@unique([userId, itemType, subjectId, articleId, resourceId, pyqId])
  @@map("bookmarks")
}

model Progress {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  articleId   String
  article     Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  isCompleted Boolean   @default(false)
  lastReadAt  DateTime  @default(now())

  @@unique([userId, articleId])
  @@map("progress")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String   // e.g. "USER_LOGIN", "CREATE_ARTICLE", "UPDATE_SUBJECT"
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
}
